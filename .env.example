# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"


# NextAuth v5
AUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Dónde vive el sitio, sin barra final. Sale en las canónicas, en el sitemap y
# en lo que se ve al compartir un enlace. En producción es obligatoria: sin
# ella, las direcciones del sitemap apuntarían a localhost. Se lee al arrancar,
# no al compilar: cambiar de dominio no obliga a rehacer la imagen.
SITIO_URL=https://tu-dominio.com

# Backblaze B2, API compatible con S3. El cubo va PRIVADO: las copias las
# sirve el propio sitio por /foto/…, nunca una dirección de b2, y los escaneos
# originales (bajo `originales/`) no se sirven nunca.
# Todo o nada: si falta una sola, /admin/subir responde 503 y /foto da 404.
S3_BUCKET=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Caché (Dragonfly, que habla el protocolo de Redis). Sin esto, la web
# funciona igual: cada visita consulta SQLite.
REDIS_URL="redis://127.0.0.1:6380"
